<mujoco model="muscle_hopper">
  <!--
    Minimal 1-D vertical muscle hopper.

    Degrees of freedom:
      slide_z  — torso translates vertically only (lateral motion blocked)
      knee     — single hinge joint (sagittal plane, axis = Y)

    The two DOFs give the simplest body system where a single antagonistic
    muscle pair (knee extensor + flexor) can produce rhythmic hopping.

    Body layout (z = upward):
      torso  : capsule r=0.05 h=0.30 m  mass=5 kg  (slide_z free)
      shin   : capsule r=0.04 h=0.50 m  mass=1 kg  (knee hinge at top)
      foot   : sphere  r=0.07            mass=0.3kg (contact with floor)

    q  layout : [z_torso,  theta_knee]
    qd layout : [vz_torso, omega_knee]

    Actuator:
      knee_motor — gear=1 so act[0] directly equals torque in N·m.
  -->

  <option timestep="0.002" gravity="0 0 -9.81" iterations="4"/>

  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1"
          contype="1" conaffinity="1" condim="3"
          friction="1.5 0.005 0.0001"
          rgba="0.7 0.7 0.7 1"/>

    <body name="torso" pos="0 0 0.75">
      <!-- Only vertical translation; no rotation, no lateral drift -->
      <joint name="slide_z" type="slide" axis="0 0 1"
             limited="false" armature="0" damping="0"/>
      <geom name="torso_geom" type="capsule" size="0.05 0.15"
            mass="5.0" contype="0" conaffinity="0"
            rgba="0.55 0.65 0.80 1"/>

      <body name="shin" pos="0 0 -0.15">
        <!-- Knee: positive angle = extension (leg straightens) -->
        <joint name="knee" type="hinge" axis="0 1 0"
               range="-1.5 0.2" damping="1.5" armature="0.05"/>
        <geom name="shin_geom" type="capsule" size="0.04 0.25" pos="0 0 -0.25"
              mass="1.0" contype="0" conaffinity="0"
              rgba="0.55 0.65 0.80 1"/>

        <body name="foot" pos="0 0 -0.50">
          <geom name="foot_geom" type="sphere" size="0.07"
                mass="0.3" contype="1" conaffinity="1"
                friction="1.5 0.005 0.0001"
                rgba="0.45 0.50 0.65 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- gear=1 → act[0] directly equals torque in N·m (same convention as worm) -->
  <actuator>
    <motor name="knee_motor" joint="knee" gear="1" ctrlrange="-5000 5000"/>
  </actuator>
</mujoco>
