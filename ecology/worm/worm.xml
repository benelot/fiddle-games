<mujoco model="worm">
  <!--
    4-segment swimming worm.
    Follows the Brax swimmer.xml pattern:
      • Root body uses two slide joints (X, Y) + one hinge (rot Z) for 2D motion
      • option density + viscosity activates Brax's built-in fluid force model,
        giving anisotropic drag that makes undulation produce forward thrust
      • No gravity effects in the XY plane (Z is constrained by sliders)
      • contype/conaffinity=0 on all geoms — no ground contact needed

    q layout:  [x, y, root_rot, j0, j1, j2]
    qd layout: [vx, vy, wz, dj0, dj1, dj2]
  -->
  <option density="4000" viscosity="0.1" timestep="0.002"/>

  <default>
    <geom contype="0" conaffinity="0" density="1000"/>
    <joint armature="0.0005"/>
  </default>

  <worldbody>
    <!-- Segment 0: head -->
    <body name="seg0" pos="0 0 0">
      <joint name="slider_x" type="slide" axis="1 0 0"/>
      <joint name="slider_y" type="slide" axis="0 1 0"/>
      <joint name="root_rot" type="hinge" axis="0 0 1"/>
      <geom name="g0" type="capsule" fromto="-0.09 0 0 0.09 0 0" size="0.040"
            rgba="0.35 0.82 0.72 1"/>

      <!-- Segment 1 -->
      <body name="seg1" pos="0.21 0 0">
        <joint name="j0" type="hinge" axis="0 0 1" range="-55 55" damping="0.01"/>
        <geom name="g1" type="capsule" fromto="-0.075 0 0 0.075 0 0" size="0.036"
              rgba="0.30 0.74 0.64 1"/>

        <!-- Segment 2 -->
        <body name="seg2" pos="0.185 0 0">
          <joint name="j1" type="hinge" axis="0 0 1" range="-55 55" damping="0.01"/>
          <geom name="g2" type="capsule" fromto="-0.065 0 0 0.065 0 0" size="0.031"
                rgba="0.25 0.65 0.56 1"/>

          <!-- Segment 3: tail -->
          <body name="seg3" pos="0.16 0 0">
            <joint name="j2" type="hinge" axis="0 0 1" range="-55 55" damping="0.008"/>
            <geom name="g3" type="capsule" fromto="-0.055 0 0 0.055 0 0" size="0.025"
                  rgba="0.20 0.56 0.48 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- gear="1" → act[i] directly equals torque in N·m -->
  <actuator>
    <motor name="m0" joint="j0" gear="1"/>
    <motor name="m1" joint="j1" gear="1"/>
    <motor name="m2" joint="j2" gear="1"/>
  </actuator>
</mujoco>
